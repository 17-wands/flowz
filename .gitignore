# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local session data (plans, memory, project-specific context)
.claude/

# Installed skills (reproducible from skills-lock.json via `npx skills experimental_install`)
# Use /* not / so negation rules for manually-maintained skills can work
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/handoff/
.agents/skills/handoff/*
!.agents/skills/handoff/SKILL.md
